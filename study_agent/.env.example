# ── LLM Provider — set ONE of these ───────────────────────────────────────

# Option 1: OpenAI (recommended — gpt-4o-mini is cheap and capable)
OPENAI_API_KEY=sk-your-key-here

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 3: Ollama (completely free, runs locally)
# Install: https://ollama.ai
# Pull model: ollama pull llama3
# USE_OLLAMA=true

# ── Optional: LangSmith tracing (free tier) ───────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__your-key
# LANGCHAIN_PROJECT=study-agent
